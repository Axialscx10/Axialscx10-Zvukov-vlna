    android:viewportHeight="180">

    <!-- Deep obsidian audiophile background -->
    <path
        android:pathData="M0,0h320v180h-320z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="320"
                android:endY="180"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF0E0D14" />
                <item android:offset="0.55" android:color="#FF1A1423" />
                <item android:offset="1.0" android:color="#FF2A1215" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle ambient crimson glow on the left -->
    <path
        android:pathData="M78,90m-62,0a62,62 0,1 1,124 0a62,62 0,1 1,-124 0"
        android:fillColor="#22FF3B5C" />

    <!-- Vinyl disc body -->
    <path
